# Worker local (le deploiement manage injecte MISTRAL_SA_TOKEN_PATH tout seul).
mistral_api_key=

# PAT GitLab du pipeline (scopes read_repository, write_repository, api).
# En deploiement manage : binder le secret workspace `gitlab_token` -> env GITLAB_TOKEN.
gitlab_token=

# Dossier de clone des repos cibles (defaut : /tmp/pipeline-workspaces).
pipeline_workspace=

# Overrides optionnels (convention minuscules) :
# pipeline_base_branch=develop
# pipeline_test_cmd=npm run test-unit -- --ci
